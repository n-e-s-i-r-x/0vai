{
  "rewrites": [
    { "source": "/Oasis",   "destination": "/index.html" },
    { "source": "/ApiKeys", "destination": "/index.html" },
    { "source": "/Owner",   "destination": "/index.html" },
    { "source": "/api/v1/chat/model",     "destination": "/api/v1/chat/model" },
    { "source": "/v1/chat/completions",   "destination": "/api/v1/chat/completions" },
    { "source": "/v1/models",             "destination": "/api/v1/chat/completions" },
    { "source": "/api/v1/models",         "destination": "/api/v1/chat/completions" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, api-key, x-api-key, X-Api-Key, Api-Key" }
      ]
    }
  ]
}
